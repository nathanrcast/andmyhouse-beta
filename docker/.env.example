# Copy this to `.env` next to docker-compose.yml, then edit.

# Required: cookie + session signing key, and encrypts stored Google tokens at rest.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# PERMANENT — changing it after setup makes connected Google accounts unrecoverable.
ANDMYHOUSE_SECRET_KEY=change-me-to-a-long-random-string

# Optional: default household timezone (overridable in the setup wizard)
ANDMYHOUSE_TZ=UTC

# Optional: public URL when running behind a reverse proxy
# ANDMYHOUSE_BASE_URL=https://family.example.com

# Optional: set to 1 to allow re-running the setup wizard (DESTRUCTIVE — wipes household)
ANDMYHOUSE_ALLOW_SETUP_RESET=0
